# npm run verify and npm run rebuild need none of these.
# The rolling panel only (npm run panel). Your own key from partners.near-intents.org.
INTENTS_EXPLORER_JWT=
# Set to off to remove the panel and its job.
EXPLORER_PANEL=
# Testnet only, for the daily attest job.
NEAR_ATTEST_ACCOUNT=
NEAR_ATTEST_PRIVATE_KEY=
# Server only, never NEXT_PUBLIC_. Read-only: the BFF reads data files and the panel artifact (needs Actions: read).
GITHUB_DATA_TOKEN=
# Optional alarm.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public channel for Easy-worded updates (docs/PLAN.md §6i). Leave empty and public messages only print.
TELEGRAM_CHANNEL_ID=
# Demo video only.
ELEVENLABS_API_KEY=
